GOOGLE_MAPS_API_KEY=VOTRE_CLE_PLACES_API_NEW
# Facultatif : utilisez une clé distincte, restreinte à Maps Static API.
GOOGLE_MAPS_STATIC_API_KEY=VOTRE_CLE_MAPS_STATIC_API

# Fondations CRM — utilisez des secrets distincts hors développement local.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://prospect:prospect-development-only@127.0.0.1:5432/prospect
# En production, ce compte de migration doit être distinct du rôle applicatif.
MIGRATION_DATABASE_URL=postgresql+asyncpg://prospect:prospect-development-only@127.0.0.1:5432/prospect
REDIS_URL=redis://127.0.0.1:6379/0
PUBLIC_APP_URL=http://localhost:5173

# Identité et sessions. En production, utiliser __Host-prospect_session et Secure=true.
SESSION_COOKIE_NAME=prospect_session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
INVITATION_TTL_SECONDS=259200
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_PAIR_FAILURES=5
LOGIN_RATE_LIMIT_ADDRESS_FAILURES=20

# Bootstrap manuel et unique du premier administrateur de plateforme.
# BOOTSTRAP_PLATFORM_ADMIN_CONFIRM=CREATE_FIRST_PLATFORM_ADMIN
# BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.ca
# BOOTSTRAP_PLATFORM_ADMIN_DISPLAY_NAME=Administrateur
# BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=secret-fourni-hors-depot

# Paramètres opérationnels facultatifs (les valeurs affichées sont les valeurs par défaut).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GOOGLE_PLACES_TIMEOUT_SECONDS=30
# GOOGLE_STATIC_MAPS_TIMEOUT_SECONDS=20
# MAP_SNAPSHOT_GRANT_TTL_SECONDS=300
# MAP_SNAPSHOT_GRANT_MAX_ENTRIES=1000
# DEPENDENCY_CONNECT_TIMEOUT_SECONDS=2
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# REDIS_MAX_CONNECTIONS=20
