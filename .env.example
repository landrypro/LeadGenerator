GOOGLE_MAPS_API_KEY=VOTRE_CLE_PLACES_API_NEW
# Facultatif : utilisez une clé distincte, restreinte à Maps Static API.
GOOGLE_MAPS_STATIC_API_KEY=VOTRE_CLE_MAPS_STATIC_API

# Fondations CRM — utilisez des secrets distincts hors développement local.
APP_ENV=development
# Le serveur Web utilise uniquement le rôle non propriétaire créé par Docker Compose.
DATABASE_URL=postgresql+asyncpg://prospect_app:prospect-app-development-only@127.0.0.1:5432/prospect
# Alembic utilise le propriétaire, jamais le serveur Web.
MIGRATION_DATABASE_URL=postgresql+asyncpg://prospect:prospect-development-only@127.0.0.1:5432/prospect
# Doit correspondre au mot de passe du rôle prospect_app dans DATABASE_URL.
POSTGRES_APP_PASSWORD=prospect-app-development-only
REDIS_URL=redis://127.0.0.1:6379/0
# Répertoire privé, monté hors des fichiers statiques ; les CSV temporaires sont effacés sous 24 h.
IMPORT_TEMP_DIRECTORY=.runtime/imports
IMPORT_TEMP_MAX_BYTES=10485760
PUBLIC_APP_URL=http://localhost:5173

# Identité et sessions. En production, utiliser __Host-prospect_session et Secure=true.
SESSION_COOKIE_NAME=prospect_session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
INVITATION_TTL_SECONDS=259200
# Mailpit intercepte uniquement les courriels de test locaux.
INVITATION_DELIVERY_BACKEND=mailpit
INVITATION_FROM_EMAIL=no-reply@marketteo.local
INVITATION_SMTP_HOST=127.0.0.1
INVITATION_SMTP_PORT=1025
INVITATION_SMTP_TIMEOUT_SECONDS=5
INVITATION_ATTEMPT_WINDOW_SECONDS=900
INVITATION_ATTEMPT_ADDRESS_MAX=30
INVITATION_ATTEMPT_TOKEN_MAX=10
INVITATION_RESEND_COOLDOWN_SECONDS=60
INVITATION_RESEND_WINDOW_SECONDS=86400
INVITATION_RESEND_MAX_PER_WINDOW=5
# Générez une valeur aléatoire locale d'au moins 32 octets ; ne réutilisez pas cet exemple.
RATE_LIMIT_HMAC_KEY=changez-cette-cle-locale-avant-utilisation
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_PAIR_FAILURES=5
LOGIN_RATE_LIMIT_ADDRESS_FAILURES=20

# Bootstrap manuel et unique du premier administrateur de plateforme.
# BOOTSTRAP_PLATFORM_ADMIN_CONFIRM=CREATE_FIRST_PLATFORM_ADMIN
# BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.ca
# BOOTSTRAP_PLATFORM_ADMIN_DISPLAY_NAME=Administrateur
# BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=secret-fourni-hors-depot

# Paramètres opérationnels facultatifs (les valeurs affichées sont les valeurs par défaut).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GOOGLE_PLACES_TIMEOUT_SECONDS=30
# Doit couvrir le délai Places, deux opérations Redis et une marge ; défaut 45.
# GOOGLE_SEARCH_LOCK_TTL_SECONDS=45
# Protection opérationnelle : journée UTC, avant l'unique appel Places. Ce ne sont pas des limites contractuelles de plan.
# GOOGLE_SEARCH_USER_DAILY_LIMIT=20
# GOOGLE_SEARCH_ORGANIZATION_DAILY_LIMIT=100
# GOOGLE_SEARCH_QUOTA_WARNING_PERCENT=80
# GOOGLE_SEARCH_QUOTA_POLICY_CODE=server_default_v1
# GOOGLE_STATIC_MAPS_TIMEOUT_SECONDS=20
# MAP_SNAPSHOT_GRANT_TTL_SECONDS=300
# GOOGLE_SELECTION_GRANT_TTL_SECONDS=600
# Les limites MAP_SNAPSHOT_GRANT_MAX_ENTRIES et GOOGLE_SELECTION_GRANT_MAX_ENTRIES
# ne concernent plus le profil d'exécution ; elles sont réservées aux doublures de test.
# DEPENDENCY_CONNECT_TIMEOUT_SECONDS=2
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# REDIS_MAX_CONNECTIONS=20
# Observabilité : aucun navigateur ne doit appeler /internal/metrics. En staging/production,
# LOG_FORMAT=json et METRICS_ENABLED=true sont obligatoires ; injectez le bearer via le coffre de secrets.
# LOG_FORMAT=text
# INSTANCE_ID=api-local-1
# METRICS_ENABLED=false
# METRICS_BEARER_TOKEN=secret-d-au-moins-32-octets-hors-depot
