# Copy to .env.preprod only on the isolated preproduction host.
# Values are loaded from AWS Parameter Store or Secrets Manager. Never commit .env.preprod.

PREPROD_DOMAIN=preprod.example.com
PREPROD_PARAMETER_PREFIX=/marketteo/preproduction
PREPROD_APP_IMAGE=000000000000.dkr.ecr.ca-central-1.amazonaws.com/marketteo-crm@sha256:replace-with-64-lowercase-hex
RELEASE_GIT_SHA=replace-with-commit-sha
RELEASE_IMAGE_DIGEST=sha256:replace-with-64-lowercase-hex
APP_VERSION=5.1.0

APP_ENV=staging
PUBLIC_APP_URL=https://preprod.example.com
CORS_ALLOWED_ORIGINS=https://preprod.example.com
SESSION_COOKIE_NAME=__Host-prospect_session
SESSION_COOKIE_SECURE=true
LOG_FORMAT=json
INSTANCE_ID=preprod-api
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=replace-with-32-byte-minimum-secret

POSTGRES_DB=prospect
POSTGRES_USER=prospect
POSTGRES_PASSWORD=replace-with-owner-secret
POSTGRES_APP_PASSWORD=replace-with-app-secret
POSTGRES_WORKER_PASSWORD=replace-with-worker-secret
DATABASE_URL=postgresql+asyncpg://prospect_app:replace-with-app-secret@postgresql:5432/prospect
MIGRATION_DATABASE_URL=postgresql+asyncpg://prospect:replace-with-owner-secret@postgresql:5432/prospect
WORKER_DATABASE_URL=postgresql+asyncpg://prospect_worker:replace-with-worker-secret@postgresql:5432/prospect
JOB_IDEMPOTENCY_HMAC_KEY=replace-with-32-byte-minimum-secret
RATE_LIMIT_HMAC_KEY=replace-with-32-byte-minimum-secret
REDIS_URL=redis://redis:6379/0

# Providers remain disabled or simulated throughout P5.1.
AUTOMATION_ENABLED=false
AUTOMATION_ASSISTANT_ENABLED=false
AUTOMATION_ASSISTANT_PROVIDER=fake
META_LEAD_ADS_ENABLED=false
INVITATION_DELIVERY_BACKEND=disabled
INVITATION_FROM_EMAIL=no-reply@preprod.example.com

GOOGLE_MAPS_API_KEY=replace-with-restricted-test-key
GOOGLE_MAPS_STATIC_API_KEY=replace-with-restricted-test-key
PREPROD_BACKUP_S3_URI=s3://replace-with-encrypted-preprod-backup-prefix
PREPROD_BACKUP_KMS_KEY_ID=replace-with-kms-key-id-or-alias
